# ── 用户与权限存储（MySQL，必填）──
# 首次启动且 users 表为空时，用 ADMIN_PASSWORD 种子一个 admin 账号。
# 之后用户全部在后台「👤 用户管理」里维护，此变量不再被读取。
# 占位符（PleaseChangeMe / changeme / password / 123456 / admin / admin123 等）视为未配置。
ADMIN_PASSWORD=

# 数据库连接。只改 MYSQL_HOST 这一个变量就能在两种部署方式之间切换：
#   mysql        → 用 compose 内置的 mysql 容器（默认，MYSQL_PASSWORD 会由脚本自动生成）
#   127.0.0.1等 → 用你已有的 MySQL 实例（脚本不会代填 MYSQL_PASSWORD，需自己填）
# 内置 mysql 服务挂在 profiles: ["builtin-mysql"] 上，脚本会按这个值自动激活或跳过，
# docker-compose.yml 不用动。
#
# ⚠️  "mysql" 是开关值，不是主机名。你的外部 MySQL 容器即使也叫 mysql
#     （Nightingale / 各种监控栈的默认名就是这样），也不要填这个值：
#     填了会额外拉起一个空 mysql 容器，并且脚本会以为在用内置库、
#     自动生成随机 MYSQL_PASSWORD 写进 .env 覆盖你的真密码 → 1045。
#     外部库一律填真实地址：同机宿主机用 host.docker.internal，跨机用 IP/域名。
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=sites_nav
MYSQL_PASSWORD=
MYSQL_DATABASE=sites_nav
# compose 内置 mysql 用的 root 密码，仅在数据卷首次初始化时生效
MYSQL_ROOT_PASSWORD=

# 会话有效期（小时），默认 12。超时后前端清状态回 /admin 重新登录
TOKEN_TTL_HOURS=12

# ── 宿主监听端口 ──
# 容器内固定 8000，这里改的是宿主机映射端口（docker-compose.yml: ${PORT:-8000}:8000）
# 不写这行 = 8000。deploy.sh / bootstrap.sh 的端口检查也会读它
# PORT=8000

# ── categraf http_provider（可选）──
# categraf 拉取配置用的 Bearer token（32 字节 hex 即可：openssl rand -hex 32）
# 与登录账密解耦：登录密码只用于 Web 页面，categraf config.toml 里只放这个 token
# 不设则 /api/config/http_response 端点公开（不推荐生产环境）
# CATEGRAF_TOKEN=
